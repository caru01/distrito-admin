# ============================
# Variables de entorno - distrito-admin
# Configura estas variables en Vercel (Settings > Environment Variables)
# ============================

# URL base de la API en Render (SIN barra al final, SIN /api/pedidos)
VITE_API_URL=auto

# Puerto usado cuando VITE_API_URL=auto para pruebas LAN/Internet
VITE_API_PORT=3001

# URL de la tienda pública. Usa auto para conservar el hostname actual en LAN.
VITE_STOREFRONT_URL=auto
VITE_STOREFRONT_PORT=5173
